<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron 43 main-process V8 JIT. Do not add unsigned executable memory. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- OpenPipal voice input and live interpretation. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- User-approved MCP App capabilities. TCC still prompts before access. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>

  <!-- Window inspection, focus tracking, and approved paste operations. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
