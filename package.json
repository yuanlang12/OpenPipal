{
  "name": "openpipal",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "OpenPipal - Universal AI Companion Assistant",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "electron:install": "install-electron --no",
    "predev": "npm run electron:install",
    "dev": "electron-vite dev",
    "prebuild": "npm run electron:install",
    "build": "electron-vite build",
    "postbuild": "node scripts/copy-photon-wasm.mjs",
    "build:acp": "npm --prefix openpipal-acp run build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && npm run build:acp && electron-builder --dir",
    "build:mac": "npm run build && npm run build:acp && electron-builder --mac",
    "build:win": "npm run build && npm run build:acp && electron-builder --win",
    "build:win:cross": "node scripts/build-windows.mjs",
    "release:verify-windows": "node scripts/verify-windows-release.mjs",
    "lint": "eslint src",
    "pretest:unit": "npm run electron:install",
    "test:unit": "vitest run",
    "open-source:verify-candidate": "node scripts/verify-open-source-candidate.mjs",
    "release:build-macos": "npm run build && npm run build:acp && electron-builder --mac --config electron-builder.release.yml",
    "release:verify-macos": "node scripts/verify-macos-release.mjs",
    "open-source:inventory": "node scripts/generate-third-party-inventory.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.44",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.21.5",
    "i18next": "26.3.6",
    "ignore": "7.0.5",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "perfect-freehand": "^1.2.3",
    "protobufjs": "^8.6.0",
    "quickjs-emscripten": "^0.32.0",
    "react-i18next": "17.0.11",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "ws": "^8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "diff": "^8.0.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.7",
    "electron-vite": "^2.3.0",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "lucide-react": "^1.6.0",
    "marked": "^17.0.4",
    "mermaid": "^11.13.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.15",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.7",
    "zustand": "^5.0.12"
  }
}
